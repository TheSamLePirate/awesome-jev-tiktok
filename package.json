{
  "name": "awesome-jev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web; wait",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint server shared web",
    "test": "bun test server/tests && bun run test:web",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "test:web": "bun test --preload ./web/tests/setup.ts web/tests",
    "test:web:cov": "bun test --preload ./web/tests/setup.ts --coverage web/tests",
    "e2e": "playwright test",
    "e2e:live": "playwright test e2e/live.spec.ts",
    "e2e:report": "playwright show-report e2e/.report"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-bun": "^0.91.2",
    "@openrouter/sdk": "^1.3.8",
    "effect": "^3.22.2",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
