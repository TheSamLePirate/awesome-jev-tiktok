# Copy to .env (Bun loads it). Every variable: docs/CONFIGURATION.md
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
# optional: watch this account from boot and connect when it goes live
TIKTOK_USERNAME=
TIKTOK_SESSION_ID=
PORT=3001
# loopback by default; to open the console to the network set HOST=0.0.0.0 AND JEV_TOKEN
HOST=127.0.0.1
JEV_TOKEN=
# behind a reverse proxy you control: rate limits per X-Forwarded-For address
TRUST_PROXY=false
# replay a recording at boot instead of watching TikTok
REPLAY=
JEV_MODEL=typesafe/jev-1.13
GLM_MODEL=z-ai/glm-5.3-flash
VISION_MODEL=z-ai/glm-4.6v
TICK_MS=1000
CAPTION_EVERY_MS=6000
